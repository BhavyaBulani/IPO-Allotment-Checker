# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# ========================
# MySQL Database
# ========================
MYSQL_USER=ipo_user
MYSQL_PASSWORD=your_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ipo_checker
# REQUIRED for Aiven/managed MySQL (the code default). Use DISABLED for a
# local Docker MySQL that has no TLS listener.
MYSQL_SSL_MODE=DISABLED

# ========================
# Application security
# ========================
# One of: development | production
# In production, mock registrar scrapers refuse to return fake results.
APP_ENV=development

# Long, random string used to sign bearer tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# The shared password used to log into the internal tool (POST /api/auth/login).
APP_PASSWORD=change_me

# Comma-separated list of allowed browser origins (no wildcard when credentials are used).
CORS_ORIGINS=http://localhost:5173

# ========================
# Additional IPO sources
# ========================
# ipotracker.site (your own IPO tracker, Supabase-backed). Provides closed/
# listed IPOs that NSE/BSE drop once subscription closes.
IPOT_SUPABASE_URL=https://zdzwtiwerwtzzhclvhdo.supabase.co
IPOT_ANON_KEY=your_supabase_anon_key
IPOT_EMAIL=you@example.com
IPOT_PASSWORD=your_password

# FinAPI (finapi.upvaly.com) — structured IPO catalog. The key is required;
# without it the FinAPI source is skipped.
FINAPI_BASE_URL=https://finapi.upvaly.com
FINAPI_API_KEY=your_finapi_key

# Upstox IPO API (optional). Without a token the Upstox source is skipped.
UPSTOX_ACCESS_TOKEN=

# ========================
# Live registrar automation (Playwright)
# ========================
# Run Chromium in headless mode for live registrar checks.
LIVE_REGISTRAR_HEADLESS=1
# Navigation / element timeouts in milliseconds.
LIVE_NAV_TIMEOUT_MS=30000
LIVE_ACTION_TIMEOUT_MS=15000
# Registrar dropdown discovery (Playwright). In production this runs as a
# daily in-app loop in main.py (first scan 60s after startup, then every
# 24h). Keep off locally unless you want the heavier Playwright scan.
ENABLE_REGISTRAR_DROPDOWN_DISCOVERY=0
REGISTRAR_DROPDOWN_HEADLESS=1
# 2Captcha API key for solving image CAPTCHAs on CAPTCHA-gated registrar
# portals (Alankit, Purva, Bigshare). Leave empty to keep CAPTCHAs manual.
TWOCAPTCHA_API_KEY=
# Set to 1 to solve CAPTCHAs automatically via 2Captcha instead of routing them
# to the manual solve queue. Requires TWOCAPTCHA_API_KEY.
CAPTCHA_AUTO_SOLVER=0
